# Скопируйте этот файл в .env и заполните значения.
# Файл .env никогда не загружается в GitHub.

# Токен бота от @BotFather (секрет! никому не отправляйте)
BOT_TOKEN=

# Номер телефона владельца в международном формате.
# Человек с этим номером при первом /start станет владельцем.
OWNER_PHONE=+996000000000

# ID общего чата. Можно оставить пустым: владелец отправит /bind_chat
# в общем чате, и бот запомнит его сам.
GROUP_CHAT_ID=

# Координаты офиса и радиус геозоны в метрах.
# Сейчас — центр села Чапаев (Ноокатский р-н). Замените на точные координаты здания офиса.
OFFICE_LAT=40.27778
OFFICE_LON=72.63611
OFFICE_RADIUS_M=100

# Максимально допустимая погрешность GPS в метрах.
MAX_ACCURACY_M=100

# Часовой пояс и график работы.
TIMEZONE=Asia/Bishkek
WORK_START=09:00
WORK_END=18:00
# Допустимая задержка в минутах: опоздание фиксируется, если приход позже начала смены больше чем на это число.
GRACE_MINUTES=5
# Рабочие дни: 1 — понедельник ... 7 — воскресенье.
WORK_DAYS=1,2,3,4,5

# Ссылка на 2ГИС для отметок «в полях».
TWOGIS_BASE_URL=https://2gis.kg

# Файл базы данных.
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
