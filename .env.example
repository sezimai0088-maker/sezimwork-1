# Скопируйте этот файл в .env и заполните значения.
# Файл .env никогда не загружается в GitHub.

# Токен бота от @BotFather (секрет! никому не отправляйте)
BOT_TOKEN=

# Номер телефона владельца в международном формате.
# Человек с этим номером при первом /start станет владельцем.
# Несколько владельцев — через запятую: +996555111111,+996555222222
# (ещё одного владельца можно добавить и в самом боте командой /add_owner)
OWNER_PHONE=+996000000000

# ID общего чата. Можно оставить пустым: владелец отправит /bind_chat
# в общем чате, и бот запомнит его сам.
GROUP_CHAT_ID=

# Координаты офиса и радиус геозоны в метрах.
# ТЕСТОВЫЕ координаты (Бишкек) — для проверки бота.
# Перед запуском в офисе замените на координаты здания: с. Чапаев, ул. Төлөнов, 12.
OFFICE_LAT=42.866468
OFFICE_LON=74.499384
OFFICE_RADIUS_M=100

# Максимально допустимая погрешность GPS в метрах.
MAX_ACCURACY_M=100

# Часовой пояс и график работы.
TIMEZONE=Asia/Bishkek
WORK_START=08:30
WORK_END=17:30
# Допустимая задержка в минутах: опоздание фиксируется, если приход позже начала смены больше чем на это число.
GRACE_MINUTES=5
# Рабочие дни: 1 — понедельник ... 7 — воскресенье.
WORK_DAYS=1,2,3,4,5

# Через сколько рабочих дней подряд со статусом «Не успел» руководителю приходит алерт.
ALERT_DAYS=2

# Отчёты и напоминания (время по часовому поясу TIMEZONE)
DAILY_REPORT_TIME=19:00
# Недельный отчёт — по понедельникам, месячный — 1-го числа, в это время
WEEKLY_REPORT_TIME=09:00
# Напомнить отметиться через N минут после начала смены
CHECKIN_REMINDER_MIN=15
# Сводка «ещё не отметились» в общий чат через N минут после начала смены
MORNING_SUMMARY_MIN=30
# Напомнить завершить день через N минут после конца смены
CHECKOUT_REMINDER_MIN=30
# Ночной бэкап базы владельцу в личный чат
BACKUP_TIME=03:00
# Если сотрудник не нажал «Отправить план», приход и план уйдут в общий чат сами через N минут
PLAN_AUTOSEND_MIN=15

# Ссылка на 2ГИС для отметок «в полях».
TWOGIS_BASE_URL=https://2gis.kg

# Файл базы данных.
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# --- Только для хостинга (Render) ---
# DATABASE_URL — строка подключения Supabase (Session pooler) с вашим паролем
# На Render адрес бота подставляется сам. Для другого хостинга можно указать вручную:
# WEBHOOK_BASE_URL=https://ваш-адрес

# Язык сообщений в общем чате: ky — кыргызский, ru — русский. Каждый сотрудник выбирает свой язык сам.
GROUP_LANG=ky
# Можно ли отмечать приход вне офиса (по работе) с комментарием: true / false
ALLOW_OUTSIDE_CHECKIN=true
